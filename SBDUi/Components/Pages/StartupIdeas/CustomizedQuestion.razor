@page "/createlistedquestions"
@rendermode InteractiveServer
@inject NavigationManager nm


<h3>Listed Questions</h3>


<EditForm Model="entListedQuestion" OnSubmit="SaveListedQuestion" FormName="ListedQuestion">
    <table width="100%">
        <tr>
            <td>
                <select value="@SelectedSubCatId" @onchange="GetItemsBySubCate" class="form-control">
                    <option value="" selected>Select Category</option>
                    @foreach (var item in entSubCategories)
                    {
                        <option value="@item.SubCategoryId">@item.SubCatogeryName</option>
                    }
                </select>
            </td>
            <td>
                <select @bind="SelectItemId" class="form-control">
                    <option value="" selected>Select Item</option>
                    @foreach (var item in entItems)
                    {


                        <option value="@item.ItemId">@item.ItemName</option>


                    }
                </select>
            </td>
            <td>
                <select @bind="entListedQuestion.QuestionType" class="form-control">
                    <option value="">
                        Select Question Type
                    </option>
                    <option value="MCQ">
                        MCQ
                    </option>
                    <option value="Rating">
                        Rating
                    </option>
                    <option value="Text">
                        Text
                    </option>
                </select>
            </td>

        </tr>
        <tr>
            <td colspan="4">
                <textarea rows="5" placeholder="Enter Question text here" @bind="entListedQuestion.QuestionText" class="form-control"></textarea>
         
            </td>
        </tr>
        <tr>
            <td>
                <button class="btn btn-primary">Save</button>
            </td>
        </tr>
    </table>
   
   
   
   

</EditForm>





<p class="text-danger">@ErrorMessage</p>

@code {
    [Parameter] public string? SubCatId { get; set; }

    private EntSurvey entSurvey = new();
    private List<EntCustomQuestions> entCustomQuestions = new();
    private Dictionary<string, List<EntCustomQuestionOpt>> optionsDictionary = new();
    private string ErrorMessage { get; set; } = string.Empty;

    EntSubCategories entSubCategory { get; set; } = new EntSubCategories();
    List<EntSubCategories> entSubCategories = new List<EntSubCategories>();
    EntItems entItem { get; set; } = new EntItems();
    List<EntItems> entItems { get; set; } = new List<EntItems>();
    private string? SelectedSubCatId;
    private string? SelectItemId;

    private EntListedQuestion entListedQuestion = new();

    protected override async Task OnInitializedAsync()
    {
        entSubCategory.fk_CategoryId = int.Parse("1");
        entSubCategories = await CRUD.ReadDataAsync<EntSubCategories>("sp_GetSubCategories", entSubCategory);
        if (!string.IsNullOrEmpty(SubCatId))
        {
            // await LoadSurveyAsync(SubCatId);
            // await LoadQuestionsAsync(SubCatId);
        }
    }
    private async Task GetItemsBySubCate(ChangeEventArgs e)
    {
        SelectedSubCatId = e.Value?.ToString();
        entItem.fk_SubCatId = int.Parse(SelectedSubCatId);
        entItems = await CRUD.ReadDataAsync<EntItems>("sp_GetItems", entItem);
    }
    private async void SaveListedQuestion()
    {
        entListedQuestion.fk_SubCatId =int.Parse(SelectedSubCatId);
        entListedQuestion.fk_ItemId = int.Parse(SelectItemId);
        SBDDAL.CRUD.CUDAsync(entListedQuestion, "sp_CreateListedQuestion");
        nm.NavigateTo("listedquestions");
    }
    private async Task SubmitQuestions()
    {
        try
        {

            await SaveQuestionAsync();

            nm.NavigateTo("SurveyDetails/");
        }
        catch (Exception ex)
        {
            ErrorMessage = "*All fields required*";
            throw ex;
        }
    }

    private void AddQuestion()
    {
        entCustomQuestions.Add(new EntCustomQuestions { SubCatId = Convert.ToInt32(SubCatId) });
    }

    private void AddOption(string id)
    {
        if (!optionsDictionary.ContainsKey(id))
        {
            optionsDictionary[id] = new List<EntCustomQuestionOpt>();
        }
        optionsDictionary[id].Add(new EntCustomQuestionOpt { QuestionId = Convert.ToInt32(id) });
    }


    private async Task SaveQuestionAsync()
    {
        foreach (var question in entCustomQuestions)
        {
            var q = new EntCustomQuestions { QuestionId = question.QuestionId };
            var ques = await CRUD.ReadDataAsync<EntCustomQuestions>("sp_CustomReadQuestion", q);

            if (ques.Count() >= 1)
            {
                await CRUD.CUDAsync(question, "sp_CustomUpdateQuestion");

                if (question.QuestionType == "MCQ" && optionsDictionary.ContainsKey(question.QuestionId.ToString()))
                {
                    foreach (var option in optionsDictionary[question.QuestionId.ToString()])
                    {
                        var o = new EntOption { OptionId = option.OptionId.ToString() };
                        var opt = await CRUD.ReadDataAsync<EntOption>("sp_ReadCustomOption", o);

                        option.QuestionId = question.QuestionId;
                        if (opt.Count >= 1)
                        {
                            await CRUD.CUDAsync(option, "sp_CustomUpdateOption");
                        }
                        else
                        {

                            await CRUD.CUDAsync(option, "sp_CustomCreateOption");

                        }

                    }
                }
            }
            else
            {
                await CRUD.CUDAsync(question, "sp_ReadCustomQuestion");

                if (question.QuestionType == "MCQ" && optionsDictionary.ContainsKey(question.QuestionId.ToString()))
                {
                    foreach (var option in optionsDictionary[question.QuestionId.ToString()])
                    {
                        option.QuestionId = question.QuestionId;
                        await CRUD.CUDAsync(option, "sp_CustomCreateOption");
                    }
                }

            }

        }
    }

    // private async Task LoadSurveyAsync(string SubCarId)
    // {
    //     EntSurvey ents = new EntSurvey {  = surveyId };
    //     var entSurveys = await CRUD.ReadDataAsync<EntSurvey>("sp_ReadSurvey", ents);
    //     if (entSurveys.Any())
    //     {
    //         entSurvey = entSurveys.First();
    //     }
    // }

    private async Task LoadQuestionsAsync(int SubCarId)
    {
        EntCustomQuestions entq = new EntCustomQuestions { SubCatId = Convert.ToInt32(SubCatId) };
        entCustomQuestions = await CRUD.ReadDataAsync<EntCustomQuestions>("sp_ReadQuestionsBySurveyID", entq);

        foreach (var question in entCustomQuestions)
        {
            if (question.QuestionType == "MCQ")
            {
                EntCustomQuestionOpt ento = new EntCustomQuestionOpt { QuestionId = Convert.ToInt32(question.QuestionId) };
                var options = await CRUD.ReadDataAsync<EntCustomQuestionOpt>("sp_ReadOptionsByQID", ento);
                optionsDictionary[question.QuestionId.ToString()] = options;
            }
        }
    }
}

